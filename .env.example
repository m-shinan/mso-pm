# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Browser-safe (sent to the client) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server / tooling only (never prefix with NEXT_PUBLIC_) ---
# Used by tests and the demo seed to create users. Not used by the running app.
SUPABASE_SECRET_KEY=sb_secret_...
# Session-pooler connection string for migrations and scripts/sql.mjs (password URL-encoded).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<database password>
# Personal access token (supabase.com → Account → Access Tokens) for the Management API.
SUPABASE_ACCESS_TOKEN=sbp_...

# --- Written by `npm run seed:demo` ---
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
